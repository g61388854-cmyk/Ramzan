# Скопируйте в .env и заполните. Файл .env не должен попадать в систему контроля версий.
PAI_DB_PASSWORD=
# Ключ шифрования файлов (32 байта в base64): python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
PAI_STORAGE_KEY=
PAI_ADMIN_LOGIN=admin
PAI_ADMIN_PASSWORD=
PAI_HOSTNAME=procedural-ai.local
PAI_HTTPS_PORT=443
# ИИ-контур: none | ollama
PAI_AI_PROVIDER=none
PAI_OLLAMA_MODEL=qwen2.5:7b-instruct
PAI_SESSION_IDLE_MINUTES=30
PAI_MAX_UPLOAD_MB=50
PAI_TZ=Europe/Moscow
